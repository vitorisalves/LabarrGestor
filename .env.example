# Gemini AI API Key
# Obtenha uma em: https://aistudio.google.com/app/apikey
# O app prioriza G_API_KEY se ambas estiverem presentes.
G_API_KEY=
GEMINI_API_KEY=

# URL Base da API Externa (Opcional)
OMIE_BASE_URL=https://production-manager-api.onrender.com/v1

# Backend de dados. EM PRODUÇÃO (Vercel) use supabase: o padrão do código é firestore,
# e sem DATA_BACKEND=supabase a API para de ler/gravar. (memory = só testes/dev local.)
DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Web Push (VAPID) — gere um par com: npx web-push generate-vapid-keys
# Precisa ser o MESMO par em todos os ambientes (local + Vercel Preview/Production);
# trocar o par invalida todas as inscrições existentes.
# Obrigatórias. Sem elas o push fica desativado. Nunca coloque as chaves no código.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exibido aos serviços de push (valor abaixo é só EXEMPLO: troque pelo seu e-mail)
VAPID_CONTACT_EMAIL=mailto:seu-email@exemplo.com

# Admin supremo: e-mail da conta Google que sempre entra como admin (precisa estar verificado).
# Sem esta variável ninguém é admin. A conta não pode ser rebaixada nem removida pelo sistema.
SUPER_ADMIN_EMAIL=compras.labarr@gmail.com

# Limite de requisições por minuto (por instância). Valores padrão abaixo; descomente para ajustar.
# RATE_LIMIT_IP_PER_MIN=600
# RATE_LIMIT_USER_PER_MIN=300
# RATE_LIMIT_HEAVY_PER_MIN=20

# Tamanho máximo do corpo das requisições (padrão: 4mb na Vercel, 10mb local)
# BODY_LIMIT=4mb

# Somente desenvolvimento local — ignoradas/proibidas em produção e na Vercel:
# DISABLE_PERMISSION_ENFORCEMENT=1
# RATE_LIMIT_DISABLED=1
# DISABLE_BACKGROUND_WORKER=1
